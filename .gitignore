# Extended Arabian Sea evaluation (2000-2026): large generated files.
# Everything below can be rebuilt with run_all.py.
backend/experiments/arabian_sea_2000_2026/data/raw/
backend/experiments/arabian_sea_2000_2026/data/processed/*.npz
backend/experiments/arabian_sea_2000_2026/data/processed/*.csv.gz
backend/experiments/arabian_sea_2000_2026/data/*.txt.gz
backend/experiments/arabian_sea_2000_2026/outputs/models/
backend/experiments/arabian_sea_2000_2026/outputs/predictions/
backend/experiments/arabian_sea_2000_2026/outputs/tables/*.npz

# Keep the experiment figures used in the papers and slides
# (overrides the global *.png and *pdf rules above).
!backend/experiments/arabian_sea_2000_2026/outputs/figures/*.png
!backend/experiments/arabian_sea_2000_2026/outputs/figures/*.pdf

# 10-model benchmark: large generated files (rebuild with run_benchmark.py)
backend/experiments/benchmark_10_models/outputs/*/models/
backend/experiments/benchmark_10_models/outputs/*/predictions/
backend/experiments/benchmark_10_models/outputs/_quick/
!backend/experiments/benchmark_10_models/outputs/*/figures/*.png
!backend/experiments/benchmark_10_models/outputs/*/figures/*.pdf
