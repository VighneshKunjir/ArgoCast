# Copy to .env and fill in what you need. Everything is optional.

# Gemini API key for conversational answers. Without it, FloatChat answers with its
# built-in grounded templates (fully offline).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Database. Default: SQLite file at backend/data/floatchat.db
# DATABASE_URL="postgresql+psycopg://user:password@localhost:5432/floatchat"

# Web server (Node) settings
PORT=3000
PYTHON_BACKEND_URL="http://localhost:8000"
